#!/command/with-contenv sh
# shellcheck shell=sh
# Встроенный Camofox («Браузер с защитой от блокировок», K21-336).
#
# Сервер доступен профилям по умолчанию; явный выбор другого браузера сохраняется.
# Маркер enabled сверяется при старте и сохранении настроек. Если все выбрали другой браузер или
# при выключателе disabled слот ждёт в sh: нет ни Node, ни Firefox, ни Python.
# Не используем exit 125 из finish: такой слот больше не перезапускается.
# Отключение последнего профиля останавливает слот через s6-svc -t;
# остановленную через -d службу поднимает s6-svc -u.

data_root="${KORRA_HOME:-${HERMES_HOME:-/opt/data}}"
switch="$data_root/camofox/disabled"
enabled="$data_root/camofox/enabled"
server="${KORRA_CAMOFOX_HOME:-/opt/camofox}/node_modules/@askjo/camofox-browser/server.js"

while [ -f "$switch" ] || [ ! -f "$server" ]; do
    sleep 3
done

# with-contenv возвращает HOME=/root; профили и кэши должны лежать в /opt/data.
export HOME=/opt/data
cd /opt/data
# shellcheck disable=SC1091
. /opt/hermes/.venv/bin/activate

# После обновления учитываем явный выбор и профили без выбора браузера.
# sync не сигналит собственному слоту s6. При ошибке остаёмся в ожидании.
if [ "$(id -u)" = 0 ]; then
    s6-setuidgid hermes python -m korra_cli.camofox_embedded sync
else
    python -m korra_cli.camofox_embedded sync
fi

while [ -f "$switch" ] || [ ! -f "$enabled" ]; do
    sleep 3
done

# Unix-сокет (<данные>/camofox/server.sock, 0600), ключ доступа, выключенная
# телеметрия и белый список окружения задаёт сам модуль; TCP-порта у сервера
# нет, ключ в лог не попадает.
[ "$(id -u)" = 0 ] || exec python -m korra_cli.camofox_embedded serve
exec s6-setuidgid hermes python -m korra_cli.camofox_embedded serve
