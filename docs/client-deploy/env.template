# Ключи и токены контура Korra.
#
# Файл кладётся в каталог данных под именем .env, владелец 10000:10000,
# права 600. Читается при каждом запуске контура; ключ провайдера
# подхватывается и без перезапуска, остальное — после `docker restart`.
#
# Значения без кавычек, пробелов вокруг «=» нет. Пустая строка = не задано.
# Строку, которая не нужна, оставьте пустой или закомментируйте.

# ── Провайдер модели (обязательно) ────────────────────────────────────
# Ключ для прокси-провайдера контура. Имя переменной должно совпадать с
# key_env в config.yaml — форма секции описана в PROVIDER.md.
# Адрес прокси и ключ выдаёт владелец, у каждого контура они свои.
DARIO_API_KEY=

# ── Telegram (нужен, если у клиента есть бот) ─────────────────────────
# Токен от @BotFather. Само его наличие включает адаптер Telegram.
TELEGRAM_BOT_TOKEN=

# Кому бот отвечает: числовые id через запятую. Свой id человек узнаёт
# у @userinfobot. Список заполняйте всегда: без него незнакомцу уходит
# код привязки и доступ решается вручную, со списком чужое молча
# отбрасывается.
TELEGRAM_ALLOWED_USERS=

# ── Распознавание речи (необязательно) ────────────────────────────────
# Без ключа голос расшифровывается локально, моделью из образа: русский
# язык, работает без интернета, держит около гигабайта памяти и на слабом
# сервере заметно медленнее. С ключом контур сам переключается на Deepgram.
DEEPGRAM_API_KEY=

# ── Служебный API шлюза (можно не заполнять) ──────────────────────────
# Ключ к внутреннему API на петле: через него панель передаёт шлюзу
# запуски по расписанию. Если оставить пусто, контур сгенерирует ключ сам
# при первом старте и допишет строку в этот файл.
# Если задаёте вручную — не короче 16 символов, иначе служебный API не
# поднимется и запуски по расписанию будут молча теряться.
# Значение из этого файла сильнее переменной окружения контейнера.
API_SERVER_KEY=
