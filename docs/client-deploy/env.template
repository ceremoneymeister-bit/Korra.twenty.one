# Заготовка ключей контура, заполняется ДО первого запуска.
#
# Это не тот файл, который контур создаёт себе сам. На первом запуске он
# кладёт в каталог данных собственный `.env` из `korra-env.example` (корень
# репозитория): там перечислены все переменные с пояснениями, туда же пишет
# раздел «Ключи» в панели, и обновление образа этот файл не переписывает.
#
# Своя заготовка подставляется только когда `.env` в каталоге данных ещё нет.
# Отсюда единственное назначение этого файла: поднять контур уже настроенным,
# чтобы первое сообщение клиента получило ответ. Заполненный файл кладётся в
# каталог данных под именем `.env` до первого запуска — заготовка контура
# тогда не подставится.
#
# Второй путь равноправен: не класть ничего. Контур поднимется со своей
# заготовкой, на первое сообщение честно ответит «Провайдер ответа не
# настроен», и ключ добавляется в панели, в разделе «Ключи».
#
# Здесь только то, что нужно спросить у владельца и клиента до раскатки.
# Всё остальное, включая другие провайдеры, — в `korra-env.example`.
#
# Значения без кавычек, пробелов вокруг «=» нет. Файл кладётся с владельцем
# 10000:10000 и правами 600.

# Ключ провайдера ответа. Имя переменной обязано совпадать с key_env в
# config.yaml; для флот-стандарта это DARIO_API_KEY, форма секции — в
# PROVIDER.md. Адрес прокси и ключ выдаёт владелец, у каждого контура свои.
DARIO_API_KEY=

# Токен бота от @BotFather. Само его наличие включает Telegram.
TELEGRAM_BOT_TOKEN=

# Кому бот отвечает: числовые id через запятую, свой человек узнаёт у
# @userinfobot. Заполняйте всегда: без списка незнакомцу уходит код привязки
# и доступ решается вручную, со списком чужое молча отбрасывается.
TELEGRAM_ALLOWED_USERS=

# Необязательно. Без ключа речь распознаёт локальная модель из образа:
# русский язык, ничего не качается, около гигабайта памяти в работе и на
# слабом сервере заметно медленнее. С ключом контур сам уходит на Deepgram.
DEEPGRAM_API_KEY=

# Оставьте пустым. Ключ внутреннего API контур создаёт себе сам на первом
# запуске и дописывает сюда же. Если всё-таки задаёте — не короче 16
# символов, иначе служебный API не поднимется и запуски по расписанию будут
# молча теряться. Значение из файла сильнее переменной окружения контейнера.
API_SERVER_KEY=
