# Korra 21 — конфигурация контура.
#
# Этот файл создаётся один раз, при первом запуске, и дальше принадлежит
# контуру: обновление образа его не переписывает. Поэтому он намеренно
# короткий. Всё, чего здесь нет, берётся из значений по умолчанию Korra —
# распознавание речи, одобрение опасных команд, память, лимиты, каналы.
# Чем меньше строк здесь, тем меньше расхождений с образом при обновлении.
#
# Посмотреть действующие значения целиком: `korra config show`.
# Раздел «Настройки» в панели правит этот же файл.

# --- Провайдер ответа --------------------------------------------------------
#
# Пока провайдер не настроен, агент так и скажет в чате: ключ добавляют в
# разделе «Ключи» панели (он попадает в файл .env рядом с этим конфигом).
#
# Наш стандарт — прокси dario. Адрес у каждого контура свой, ключ живёт в
# .env под именем из `key_env`, в конфиг его не вписывают:
#
# model:
#   default: claude-opus-5[1m]
#   provider: custom:dario
#
# custom_providers:
#   - name: dario
#     base_url: http://127.0.0.1:3456
#     key_env: DARIO_API_KEY
#     api_mode: anthropic_messages
#     model: claude-opus-5
#     models:
#       claude-opus-5: {}
#       claude-opus-5[1m]:
#         context_length: 1000000
#       claude-sonnet-5: {}
#
# Прямой ключ провайдера — короче:
#
# model:
#   default: anthropic/claude-opus-4.6
#   provider: openrouter

# --- Панель ------------------------------------------------------------------
gateway:
  # Вкладки агентов в панели: все профили обслуживает один шлюз.
  # Без этого у профилей нет чата в панели.
  multiplex_profiles: true

# --- Распознавание речи ------------------------------------------------------
#
# Ничего настраивать не нужно: в образе лежит локальная модель, русский язык
# включён по умолчанию, из сети ничего не качается. Появится ключ Deepgram
# (DEEPGRAM_API_KEY в .env) — распознавание само уйдёт на него, а локальная
# модель останется запасным путём.
#
# Другой язык — так:
#
# stt:
#   language: en
